        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% =========================\n    %% CLIENTE\n    %% =========================\n    APP[\&quot;Flutter / Dart&lt;br/&gt;Windows · Android · iOS\&quot;]\n\n    %% =========================\n    %% API\n    %% =========================\n    GW[\&quot;API Gateway&lt;br/&gt;Go\&quot;]\n\n    %% =========================\n    %% SERVICIOS\n    %% =========================\n    subgraph SERVICES[\&quot;MICROSERVICIOS BACKEND · GO\&quot;]\n\n        direction LR\n\n        S1[\&quot;auth-service&lt;br/&gt;user-service&lt;br/&gt;social-service\&quot;]\n\n        S2[\&quot;post-service&lt;br/&gt;music-service&lt;br/&gt;media-service\&quot;]\n\n        S3[\&quot;chat-service&lt;br/&gt;gamification-service&lt;br/&gt;moderation-service\&quot;]\n\n        S4[\&quot;recommendation-service&lt;br/&gt;notification-service\&quot;]\n\n    end\n\n    %% =========================\n    %% ML\n    %% =========================\n    ML[\&quot;ML Service&lt;br/&gt;Python / FastAPI\&quot;]\n\n    %% =========================\n    %% INFRAESTRUCTURA\n    %% =========================\n    subgraph INFRA[\&quot;INFRAESTRUCTURA\&quot;]\n\n        direction LR\n\n        DB[\&quot;PostgreSQL\&quot;]\n        CACHE[\&quot;Redis\&quot;]\n        MQ[\&quot;RabbitMQ\&quot;]\n        STORAGE[\&quot;MinIO / S3\&quot;]\n\n    end\n\n    %% =========================\n    %% FLUJOS PRINCIPALES\n    %% =========================\n\n    APP --&gt;|\&quot;HTTP / REST\&quot;| GW\n    APP -.-&gt;|\&quot;WebSocket\&quot;| GW\n\n    GW --&gt; SERVICES\n\n    GW -.-&gt;|\&quot;WebSocket\&quot;| S3\n\n    S4 --&gt;|\&quot;HTTP / REST\&quot;| ML\n\n    %% =========================\n    %% MENSAJERÍA\n    %% =========================\n\n    SERVICES -.-&gt;|\&quot;Eventos\&quot;| MQ\n    MQ -.-&gt;|\&quot;Eventos\&quot;| SERVICES\n\n    %% =========================\n    %% PERSISTENCIA\n    %% =========================\n\n    SERVICES --&gt; DB\n    S3 --&gt; CACHE\n    S2 --&gt; STORAGE&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XHv6drCuIYn72Kcc4jXU-734">
