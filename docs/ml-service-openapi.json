{
  "openapi": "3.1.0",
  "info": {
    "title": "Meloop ML Service",
    "description": "Servicio de machine learning para recomendaciones y análisis de contenido.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness Check",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict Demo",
        "operationId": "predict_demo_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations/friends": {
      "post": {
        "summary": "Recommend Friends",
        "description": "Return the best compatible friend candidates for a user profile.",
        "operationId": "recommend_friends_recommendations_friends_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations/music": {
      "post": {
        "summary": "Recommend Music",
        "operationId": "recommend_music_recommendations_music_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MusicRecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidateProfile": {
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "User Id"
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "CandidateProfile"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "Interaction": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "like",
              "friend_added",
              "comment",
              "post_interaction"
            ],
            "title": "Type"
          },
          "target_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Target Id"
          }
        },
        "type": "object",
        "required": [
          "type",
          "target_id"
        ],
        "title": "Interaction"
      },
      "MusicCatalogItem": {
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Item Id"
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "type": "object",
        "required": [
          "item_id"
        ],
        "title": "MusicCatalogItem"
      },
      "MusicRecommendationRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "User Id",
            "description": "ID del usuario para generar recomendaciones."
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Cantidad máxima de sugerencias.",
            "default": 10
          },
          "preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferences",
            "description": "Gustos adicionales del usuario."
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "interactions": {
            "items": {
              "$ref": "#/components/schemas/Interaction"
            },
            "type": "array",
            "title": "Interactions"
          },
          "catalog": {
            "items": {
              "$ref": "#/components/schemas/MusicCatalogItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Catalog",
            "description": "Canciones o artistas candidatos que se deben ordenar."
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "catalog"
        ],
        "title": "MusicRecommendationRequest"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded"
          },
          "data_pipeline_loaded": {
            "type": "boolean",
            "title": "Data Pipeline Loaded"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "model_loaded",
          "data_pipeline_loaded"
        ],
        "title": "ReadinessResponse"
      },
      "RecommendationItem": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "score",
          "reason"
        ],
        "title": "RecommendationItem"
      },
      "RecommendationRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "User Id",
            "description": "ID del usuario para generar recomendaciones."
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Cantidad máxima de sugerencias.",
            "default": 10
          },
          "type": {
            "type": "string",
            "enum": [
              "all",
              "music",
              "friends"
            ],
            "title": "Type",
            "default": "all"
          },
          "preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferences",
            "description": "Gustos o categorías del usuario."
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "candidate_profiles": {
            "items": {
              "$ref": "#/components/schemas/CandidateProfile"
            },
            "type": "array",
            "title": "Candidate Profiles",
            "description": "Perfiles candidatos que el modelo debe ordenar."
          },
          "interactions": {
            "items": {
              "$ref": "#/components/schemas/Interaction"
            },
            "type": "array",
            "title": "Interactions",
            "description": "Interacciones recientes que pueden cambiar las sugerencias."
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "interaction_count": {
            "type": "integer",
            "title": "Interaction Count"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "recommendations",
          "model",
          "model_version",
          "interaction_count"
        ],
        "title": "RecommendationResponse"
      },
      "UserProfile": {
        "properties": {
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          },
          "artists": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artists"
          },
          "songs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Songs"
          }
        },
        "type": "object",
        "title": "UserProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
